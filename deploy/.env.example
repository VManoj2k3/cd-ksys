# Copy to deploy/.env and fill in. NEVER commit the real .env.

# Long random string to sign session cookies (e.g. `openssl rand -hex 32`)
KOOSYS_SESSION_SECRET=

# Bearer token your Prometheus scraper sends to GET /api/metrics
# (e.g. `openssl rand -hex 24`; leave empty to require a user session instead)
KOOSYS_METRICS_TOKEN=

# HuggingFace token — only needed if the model repo is gated
HF_TOKEN=

# GPU layout: split the model across both cards (default), or "" for one GPU
TENSOR_SPLIT=1,1
CTX_SIZE=16384

# CUDA arch for your GPUs: Blackwell/RTX 50-series = 120, Ada/40-series = 89,
# Ampere/30-series = 86, T4 = 75
CUDA_ARCH=120
